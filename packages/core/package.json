{
  "name": "@shinobi-cash/core",
  "version": "0.0.0-canary-20251229091317",
  "description": "Core SDK for Shinobi Cash - note generation, discovery, and ZK proof operations",
  "sideEffects": false,
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.mjs",
      "require": "./dist/auth.js"
    },
    "./deposit": {
      "types": "./dist/deposit.d.ts",
      "import": "./dist/deposit.mjs",
      "require": "./dist/deposit.js"
    },
    "./withdrawal": {
      "types": "./dist/withdrawal.d.ts",
      "import": "./dist/withdrawal.mjs",
      "require": "./dist/withdrawal.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.mjs",
      "require": "./dist/discovery.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "import": "./dist/proof.mjs",
      "require": "./dist/proof.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.mjs",
      "require": "./dist/provider.js"
    },
    "./fees": {
      "types": "./dist/fees.d.ts",
      "import": "./dist/fees.mjs",
      "require": "./dist/fees.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.mjs",
      "require": "./dist/validation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist rollup-dist",
    "analyze": "rollup -c rollup.analyze.mjs && open rollup-dist/bundle-analysis.html"
  },
  "keywords": [
    "shinobi-cash",
    "privacy",
    "zk-proof",
    "notes",
    "cryptography",
    "poseidon"
  ],
  "license": "MIT",
  "dependencies": {
    "@shinobi-cash/constants": "workspace:*",
    "@shinobi-cash/data": "workspace:*",
    "@zk-kit/lean-imt": "^2.2.4",
    "ox": "^0.13.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rollup": "^4.28.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}