{
  "name": "explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\" \"!node_modules\" \"!.next\" \"!out\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\" \"!node_modules\" \"!.next\" \"!out\""
  },
  "dependencies": {
    "@shinobi-cash/constants": "workspace:*",
    "@shinobi-cash/data": "workspace:*",
    "@tanstack/react-query": "^5.62.14",
    "@workspace/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.462.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^1.7.1",
    "viem": "^2.22.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
