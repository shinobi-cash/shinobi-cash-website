{
  "name": "shinobi-cash-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "analyze": "ANALYZE=true npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@reown/appkit": "1.8.14",
    "@reown/appkit-adapter-wagmi": "1.8.14",
    "@shinobi-cash/client": "workspace:*",
    "@shinobi-cash/constants": "workspace:*",
    "@shinobi-cash/core": "workspace:*",
    "@shinobi-cash/data": "workspace:*",
    "@tanstack/react-query": "^5.59.20",
    "@workspace/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.539.0",
    "next": "15.4.10",
    "ox": "^0.13.0",
    "permissionless": "^0.2.53",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "valtio": "^2.3.0",
    "viem": "^2.31.3",
    "wagmi": "^2.12.31"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
